cabal-version:      3.0
name:               giterator
version:            0.1.0.0
synopsis:           Inspect and rewrite git history
license:            NONE
author:             Aaron Godwood
maintainer:         azmclaz@gmail.com
build-type:         Simple
extra-doc-files:    plan.md

common shared
    default-language: GHC2021
    default-extensions: OverloadedStrings, LambdaCase
    ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
    build-depends:    base >=4.17 && <5
                    , bytestring >=0.11 && <0.13

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  Git.Types
                      Git.Object
                      Git.Store
                      Git.Pack
                      Git.Date
                      Git.Refs
                      Git.Rewrite
                      Transform.Time
                      Transform.Content
    build-depends:    base16-bytestring >=1.0 && <1.1
                    , containers >=0.6 && <0.8
                    , cryptohash-sha1 >=0.11 && <0.12
                    , regex-tdfa >=1.3 && <1.4
                    , time >=1.12 && <1.15
                    , transformers >=0.5 && <0.7
                    , typed-process >=0.2.11 && <0.3
                    , zlib >=0.6 && <0.8

executable giterator
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    giterator
                    , optparse-applicative >=0.17 && <0.19

test-suite giterator-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    other-modules:    Fixture
                      Gen
                      ObjectSpec
                      StoreSpec
                      RewriteSpec
                      TimeSpec
                      ContentSpec
    build-depends:    giterator
                    , hspec >=2.10 && <3
                    , QuickCheck >=2.14 && <2.16
                    , typed-process >=0.2.11 && <0.3
                    , directory >=1.3 && <1.4
                    , filepath >=1.4 && <1.6
                    , temporary >=1.3 && <1.4
